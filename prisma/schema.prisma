generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  PRODUCT_MANAGER
}

enum CustomizationFieldType {
  SINGLE_SELECT
  MULTI_SELECT
  TEXT
  TEXTAREA
  IMAGE_UPLOAD
}

enum OrderStatus {
  PAYMENT_PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(PRODUCT_MANAGER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Branch {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  address   String
  phone     String?
  isActive  Boolean  @default(true)
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("branches")
}

model Product {
  id                  String               @id @default(cuid())
  name                String
  slug                String               @unique
  mainCategory        String?
  collectionCode      String?
  designNumber        Int?
  catalogueCode       String?              @unique
  isSeasonal          Boolean              @default(false)
  shortDescription    String?
  description         String
  basePrice           Decimal              @db.Decimal(12, 2)
  published           Boolean              @default(false)
  isActive            Boolean              @default(true)
  images              ProductImage[]
  customizationGroups CustomizationGroup[]
  orderItems          OrderItem[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([collectionCode, designNumber])
  @@index([slug])
  @@index([published, isActive])
  @@index([mainCategory])
  @@index([collectionCode])
  @@index([catalogueCode])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model CustomizationGroup {
  id            String                 @id @default(cuid())
  productId     String
  name          String
  fieldType     CustomizationFieldType @default(SINGLE_SELECT)
  isRequired    Boolean                @default(false)
  sortOrder     Int                    @default(0)
  isActive      Boolean                @default(true)
  helperText    String?
  maxCharacters Int?
  options       CustomizationOption[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  product       Product                @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("customization_groups")
}

model CustomizationOption {
  id              String             @id @default(cuid())
  groupId         String
  label           String
  priceAdjustment Decimal            @default(0.00) @db.Decimal(12, 2)
  sortOrder       Int                @default(0)
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  group           CustomizationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("customization_options")
}

model Order {
  id                 String             @id @default(cuid())
  orderNumber        String             @unique
  idempotencyKey     String?            @unique
  accessToken        String             @unique @default(cuid())
  branchId           String
  customerName       String
  customerEmail      String
  phonePrimary       String
  phoneSecondary     String?
  readyDate          DateTime
  subtotal           Decimal            @db.Decimal(12, 2)
  customizationTotal Decimal            @db.Decimal(12, 2)
  total              Decimal            @db.Decimal(12, 2)
  orderStatus        OrderStatus        @default(PAYMENT_PENDING)
  paymentStatus      PaymentStatus      @default(PENDING)
  items              OrderItem[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  branch             Branch             @relation(fields: [branchId], references: [id])

  @@index([orderNumber])
  @@index([branchId])
  @@index([readyDate])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([accessToken])
  @@map("orders")
}

model OrderItem {
  id                  String               @id @default(cuid())
  orderId             String
  productId           String?
  productNameSnapshot String
  productSlugSnapshot String
  basePriceSnapshot   Decimal              @db.Decimal(12, 2)
  productImageSnapshot String?
  customizations      OrderCustomization[]
  createdAt           DateTime             @default(now())

  order               Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderCustomization {
  id                     String                 @id @default(cuid())
  orderItemId            String
  customizationGroupId   String?
  groupNameSnapshot      String
  fieldTypeSnapshot      CustomizationFieldType
  selectedOptionId       String?
  optionLabelSnapshot    String?
  textValue              String?
  priceAdjustmentSnapshot Decimal               @default(0.00) @db.Decimal(12, 2)
  createdAt              DateTime               @default(now())

  orderItem              OrderItem              @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@map("order_customizations")
}
