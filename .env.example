# Environment variables for Wasana Bakers

# Database (PostgreSQL / Supabase PostgreSQL)
# Local: postgresql://postgres:postgres@localhost:5432/wasana_bakers?schema=public
# Supabase Pooler (Transaction / Port 6543): postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Supabase Pooler (Session / Port 5432): postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Supabase Direct: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wasana_bakers?schema=public"

# Auth Secret
# Generate with: openssl rand -hex 32. Required in every environment.
AUTH_SECRET=
# JWT_SECRET is a legacy alias; prefer AUTH_SECRET.
ADMIN_EMAIL=admin@wasanabakers.lk
# Required only for initial account creation; at least 14 characters.
ADMIN_PASSWORD=
# Non-Vercel deployments: configure only a header overwritten by your trusted ingress.
# TRUSTED_CLIENT_IP_HEADER=x-real-ip

# Next Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional additional HTTPS image hosts, separated by commas (no wildcards).
# IMAGE_REMOTE_HOSTS=cdn.example.com

# Storage Provider Configuration
# Optional override: "local" | "supabase"
# STORAGE_PROVIDER="local"

# Supabase Storage Configuration (Required for Staging/Production deployments)
# Leave SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY unset in local development to use LocalStorageProvider.
# CRITICAL: Never expose SUPABASE_SERVICE_ROLE_KEY to client-side JavaScript.
# Do NOT prefix with NEXT_PUBLIC_. All storage operations using this key are server-side only.
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="cake-images"

# Payment provider: "simulation" (built-in gateway replica) until PayHere is integrated.
PAYMENT_PROVIDER=simulation
# Staging only: production builds reject simulation checkout unless explicitly opted in.
PAYMENT_ALLOW_SIMULATION=false
# test environment only; live requires a real gateway and a reviewed rollout.
PAYMENT_MODE=test
# Signing secret for simulated checkout links/events (must be at least 32 characters).
PAYMENT_SIMULATION_SECRET=
# Canonical application origin; HTTPS required in production.
APP_URL=
